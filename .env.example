# Canonical origin for canonical tags, Open Graph URLs, sitemap.xml, robots.txt and JSON-LD.
# No trailing slash. Set this in the Vercel project (Production scope).
NEXT_PUBLIC_SITE_URL=https://uminglobal.com

# SMTP account the contact form sends through (app/api/contact/route.ts).
# SMTP_SECURE is derived from the port when omitted: true for 465, false otherwise.
SMTP_HOST=mail.kurumsaleposta.com
SMTP_PORT=465
SMTP_USER=info@metroyazilim.com
SMTP_PASS=
SMTP_FROM=info@metroyazilim.com
# Inbox that receives enquiries. Defaults to SMTP_USER when unset.
CONTACT_TO=info@metroyazilim.com

# --- Admin panel (/manage) ---------------------------------------------
# Dedicated project PostgreSQL database (never reuse another project's database)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/umin_global?schema=public"
# At least 32 random characters; generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Used only by `npm run db:seed` to create or reset the first admin
ADMIN_EMAIL="admin@uminglobal.com"
ADMIN_PASSWORD="replace-with-a-password-of-at-least-12-characters"

# Cloudflare R2 media storage (admin media library). Falls back to an
# in-memory (dev-only, non-persistent) provider when unset.
R2_ACCOUNT_ID="replace-with-r2-account-id"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
R2_BUCKET="replace-with-bucket-name"
R2_PUBLIC_BASE_URL="https://pub-example.r2.dev"

# --- Production operations runbook --------------------------------------
# DATABASE_URL enables admin-managed content; run `npm run content:import`
# after configuring it to switch the live site from bundled fallback content.
# Set every R2_* variable above in production. Without R2, uploaded media is
# stored only in memory and will disappear whenever the application restarts.
