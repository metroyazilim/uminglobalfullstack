# Canonical origin for canonical tags, Open Graph URLs, sitemap.xml, robots.txt and JSON-LD.
# No trailing slash. Set this in the Vercel project (Production scope).
NEXT_PUBLIC_SITE_URL=https://uminglobal.com

# SMTP account the contact form sends through (app/api/contact/route.ts).
# SMTP_SECURE is derived from the port when omitted: true for 465, false otherwise.
SMTP_HOST=mail.kurumsaleposta.com
SMTP_PORT=465
SMTP_USER=info@metroyazilim.com
SMTP_PASS=
SMTP_FROM=info@metroyazilim.com
# Inbox that receives enquiries. Defaults to SMTP_USER when unset.
CONTACT_TO=info@metroyazilim.com
