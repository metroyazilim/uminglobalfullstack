# UMIN Global — production environment (Dokploy → Environment tab, or a local
# `.env` next to docker-compose.yml). Never commit the filled-in version.
#
# Values marked REQUIRED make `docker compose up` fail fast when missing.

# --- Public origin (REQUIRED) -------------------------------------------
# Baked into the client bundle at build time; drives canonical tags, OG URLs,
# sitemap.xml, robots.txt and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://uminglobal.com

# --- Database ------------------------------------------------------------
# POSTGRES_PASSWORD is REQUIRED. When DATABASE_URL is left unset, compose
# derives it from the values below and points the app at the bundled `db`
# service. Set DATABASE_URL explicitly to use a managed Postgres instead.
POSTGRES_USER=umin
POSTGRES_PASSWORD=
POSTGRES_DB=umin_global
# DATABASE_URL=postgresql://user:password@host:5432/umin_global?schema=public

# --- Admin panel auth (REQUIRED) -----------------------------------------
# At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=
# Only read by `npm run db:seed` when creating the first administrator.
ADMIN_EMAIL=admin@uminglobal.com
ADMIN_PASSWORD=

# --- SMTP (contact form) --------------------------------------------------
# SMTP_SECURE is derived from the port: true for 465, false otherwise.
# These can also be managed from the admin panel (Settings → Email), which
# stores the password encrypted; the env values are the fallback.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Inbox that receives enquiries. Defaults to SMTP_USER when unset.
CONTACT_TO=

# --- Cloudflare R2 media storage -----------------------------------------
# Without these the media library falls back to non-persistent in-memory
# storage: every upload disappears on redeploy. Always set them in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://pub-example.r2.dev
